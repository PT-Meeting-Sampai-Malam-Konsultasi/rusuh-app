default_platform(:ios)

# Paths are resolved relative to the repo root (one level above fastlane/).
REPO_ROOT       = File.expand_path("..", __dir__)
XCODE_PROJECT   = File.join(REPO_ROOT, "iosApp", "Rusuh.xcodeproj")
# Archive location: ARCHIVE_PATH wins (CI sets it), then KIROCREW_SCRATCH, then a
# repo-local build dir for a plain local run.
ARCHIVE_PATH    = ENV["ARCHIVE_PATH"] ||
                  File.join(ENV["KIROCREW_SCRATCH"] || File.join(REPO_ROOT, "build", "ios"),
                            "Rusuh.xcarchive")

platform :ios do
  desc "Build the KMP shared framework, then produce an UNSIGNED Rusuh.xcarchive (staging scheme)"
  lane :build_unsigned do
    # Phase 1: build the Kotlin Multiplatform shared framework for the iOS device slice.
    gradle(
      task: ":shared:linkReleaseFrameworkIosArm64",
      gradle_path: File.join(REPO_ROOT, "gradlew"),
      project_dir: REPO_ROOT
    )

    # Phase 2: archive the Xcode staging scheme without any code signing.
    build_app(
      project: XCODE_PROJECT,
      scheme: "Rusuh Staging",
      configuration: "Release-Staging",
      skip_codesigning: true,
      skip_package_ipa: true,
      skip_archive: false,
      archive_path: ARCHIVE_PATH,
      destination: "generic/platform=iOS",
      xcargs: 'CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO CODE_SIGN_IDENTITY="" DEVELOPMENT_TEAM=""'
    )

    UI.success("Unsigned staging archive written to #{ARCHIVE_PATH}")
  end

  desc "Build the production scheme for simulator (verification only, no archive)"
  lane :build_production_simulator do
    # Build the KMP shared framework for simulator.
    gradle(
      task: ":shared:linkDebugFrameworkIosSimulatorArm64",
      gradle_path: File.join(REPO_ROOT, "gradlew"),
      project_dir: REPO_ROOT
    )

    # Build the production scheme for simulator (no archive, just verify it compiles).
    xcodebuild(
      project: XCODE_PROJECT,
      scheme: "Rusuh Production",
      configuration: "Debug-Production",
      destination: "generic/platform=iOS Simulator",
      build: true,
      xcargs: 'CODE_SIGNING_REQUIRED=NO CODE_SIGNING_ALLOWED=NO'
    )

    UI.success("Production scheme built successfully for simulator")
  end
end
