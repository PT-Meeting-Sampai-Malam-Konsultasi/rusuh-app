<?xml version="1.0" encoding="utf-8"?>
<!--
  Default (English) UI strings. EN is the base locale per ADR-0014; the
  Indonesian translation lives in values-id/strings.xml. Add a key ONLY when a
  string is actually rendered (issue #51) — do not pre-populate unused keys.
  Accessed from composables via stringResource(Res.string.<key>).
-->
<resources>
    <!-- App / brand -->
    <string name="app_name">Rusuh</string>

    <!-- Shared navigation / actions -->
    <string name="action_back">‹ Back</string>
    <string name="action_retry">Try again</string>

    <!-- Home screen -->
    <string name="home_empty_title">No events yet</string>
    <string name="home_pull_to_refresh">Pull down to reload.</string>
    <string name="home_loading_description">Loading event list</string>

    <!-- Event status badge labels (home cards) -->
    <string name="status_available">Queue open</string>
    <string name="status_temporarily_full">Temporarily full</string>
    <string name="status_sold_out">Sold out</string>
    <string name="status_coming_soon">On sale soon</string>
    <string name="status_prefix">Status: %1$s</string>
    <!-- Passthrough for already-formatted, locale-agnostic copy (e.g. a caller-built countdown). -->
    <string name="status_passthrough">%1$s</string>

    <!-- Event card status footers -->
    <string name="event_footer_temporarily_full">Remaining tickets are being paid for by other buyers. Any that go unpaid are released within 10 minutes.</string>
